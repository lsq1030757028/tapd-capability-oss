worker_processes auto;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    server_tokens off;

    log_format tapd_safe '$remote_addr [$time_local] '
                         '"$request_method $uri $server_protocol" '
                         '$status $body_bytes_sent $request_time';
    access_log /var/log/nginx/tapd-capability.access.log tapd_safe;
    error_log /var/log/nginx/tapd-capability.error.log warn;

    limit_req_zone $binary_remote_addr zone=tapd_mcp_rate:10m rate=10r/s;
    limit_conn_zone $binary_remote_addr zone=tapd_mcp_conn:10m;

    upstream tapd_capability {
        server 127.0.0.1:3796;
        keepalive 16;
    }

    server {
        listen 443 ssl;
        server_name __STAGING_FQDN__;

        ssl_certificate __TLS_CERTIFICATE_FILE__;
        ssl_certificate_key __TLS_PRIVATE_KEY_FILE__;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TAPDMCP:10m;
        ssl_session_timeout 10m;
        ssl_session_tickets off;

        client_max_body_size 1m;
        client_body_timeout 10s;
        keepalive_timeout 65s;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        add_header Strict-Transport-Security "max-age=300" always;

        location = /healthz {
            limit_req zone=tapd_mcp_rate burst=10 nodelay;
            proxy_pass http://tapd_capability;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_set_header Authorization "";
            proxy_set_header X-TAPD-Access-Token "";
            proxy_set_header X-Forwarded-Proto https;
            proxy_connect_timeout 3s;
            proxy_send_timeout 5s;
            proxy_read_timeout 5s;
        }

        location = /mcp {
            limit_except GET POST DELETE {
                deny all;
            }
            limit_req zone=tapd_mcp_rate burst=20 nodelay;
            limit_conn tapd_mcp_conn 20;

            proxy_pass http://tapd_capability;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_set_header Authorization $http_authorization;
            proxy_set_header X-TAPD-Access-Token "";
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_connect_timeout 3s;
            proxy_send_timeout 65s;
            proxy_read_timeout 65s;
        }

        location / {
            return 404;
        }
    }
}
